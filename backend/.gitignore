# .gitignore for the backend

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment secrets — NEVER commit .env
.env

# SQLite database file generated at runtime
*.db
*.sqlite3

# Distribution / packaging
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
