# ──────────────────────────────────────────────────────────────────────────────
# SmartMart Enterprise Backend Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────

# 1. LLM Provider Configuration ('hosted_llama' or 'ollama')
LLM_PROVIDER=hosted_llama
LLAMA_MODEL=llama-3.3-70b-versatile
LLAMA_BASE_URL=https://api.groq.com/openai/v1
LLAMA_API_KEY=your_hosted_llama_or_groq_api_key_here

# Local Ollama Configuration (Option A: Local Llama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# 2. Database Configuration
# Local SQLite Development:
DATABASE_URL=sqlite:///./retail_store.db

# Production PostgreSQL with pgvector:
# DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/smartmart

# 3. Security & JWT Secrets
SECRET_KEY=generate_a_random_32_character_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 4. CORS Origins (comma-separated or list)
CORS_ORIGINS=http://localhost:5173,https://paragverma81680.github.io

# 5. Application Debug
DEBUG=False
