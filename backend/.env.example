# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
APP_NAME="AI-Based Smart Retail Store Assistant"
DEBUG=False

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — no extra setup needed):
DATABASE_URL=sqlite:///./retail_store.db

# PostgreSQL example (uncomment when you switch):
# DATABASE_URL=postgresql://user:password@localhost:5432/retail_store

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origins that are allowed to call this API.
# Separate multiple origins with commas.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── AI — Claude (Anthropic) ──────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
